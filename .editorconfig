# https://editorconfig.org
#
# Applies to the whole workspace. Overrides for specific paths are
# declared at the end. Anything not covered falls back to the root
# section.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust sources and the workspace manifest.
[*.rs]
max_line_length = 80

[*.toml]
indent_size = 4

[*.{md,markdown}]
# Keep line length in check, but do not trim hard line breaks:
# Markdown uses two trailing spaces to force a <br>.
trim_trailing_whitespace = false
max_line_length = 80
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[Justfile]
indent_style = tab

[Makefile]
indent_style = tab

# Generated or vendored files: leave alone.
[LICENSE-*]
insert_final_newline = false
trim_trailing_whitespace = false

[{Cargo.lock,.gitignore}]
insert_final_newline = true
trim_trailing_whitespace = true
